<!-- Windows-only (MSI tooling needs msi.dll). Not part of PcDoctor.sln; CI builds it after publish:
     dotnet build installer/PcDoctor.Installer.wixproj -c Release -p:PublishDir=..\out\win-x64\ -p:InstallerPlatform=x64 -->
<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>PCDoctor-$(InstallerPlatform)</OutputName>
    <!-- Set before DefineConstants, which reads it. -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.7.0</ProductVersion>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(ProductVersion)</DefineConstants>
    <SuppressValidation>false</SuppressValidation>
    <!-- WiX extensions are versioned here, not in Directory.Packages.props. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
