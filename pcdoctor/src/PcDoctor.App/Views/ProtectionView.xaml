<UserControl x:Class="PcDoctor.App.Views.ProtectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PcDoctor.App.Localization"
             xmlns:c="clr-namespace:PcDoctor.App.Controls"
             xmlns:v="clr-namespace:PcDoctor.App.Views">
    <UserControl.Resources>
        <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <v:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>
    <StackPanel>
        <v:PageHeader />

        <c:Card IsFeatured="True" IsInteractive="False" Padding="26,22" c:Motion.Appear="True" c:Motion.Index="3">
            <StackPanel>
                <Border Style="{StaticResource Kicker}" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <c:LiveDot DotBrush="{DynamicResource Good}" IsLive="{Binding IsRunning}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding EngineText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Soft}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{loc:Loc protection.scan.title}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{loc:Loc protection.scan.body}" Style="{StaticResource Text.Body}" Margin="0,6,0,16" MaxWidth="760" HorizontalAlignment="Left" />
                <WrapPanel>
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding QuickScanCommand}" Content="{loc:Loc protection.quick}" />
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding FullScanCommand}" Content="{loc:Loc protection.full}" />
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding CustomScanCommand}" Content="{loc:Loc protection.custom}" />
                    <Button Style="{StaticResource Btn.Text}" Command="{Binding CancelCommand}" Content="{loc:Loc action.cancel}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <c:ShimmerBar IsIndeterminate="True" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>
        </c:Card>

        <!-- Result -->
        <c:Card IsInteractive="False" Margin="0,14,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}"
                c:Motion.Appear="True">
            <StackPanel>
                <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource Text.Title}" AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Text="{Binding ResultBody}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                <TextBlock Text="{loc:Loc summary.disclaimer}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
                <ItemsControl ItemsSource="{Binding Detections}" Margin="0,12,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line2}" BorderThickness="1"
                                    Padding="14,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.TitleMedium}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource Text.Caption}">
                                        <Run Text="{Binding Severity, Mode=OneWay}" /> · <Run Text="{Binding When, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBox Style="{StaticResource LtrText}" Text="{Binding Paths, Mode=OneWay}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </c:Card>

        <!-- Second opinion -->
        <c:Card IsInteractive="False" Margin="0,14,0,0" c:Motion.Appear="True" c:Motion.Index="4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding SafetyScannerCommand}" Content="{loc:Loc protection.msert.run}"
                        VerticalAlignment="Center" Margin="16,0,0,0" />
                <StackPanel>
                    <TextBlock Text="{loc:Loc protection.msert.title}" Style="{StaticResource Text.TitleMedium}" />
                    <TextBlock Text="{loc:Loc protection.msert.body}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </c:Card>

        <!-- Quarantine -->
        <DockPanel Margin="0,24,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding LoadQuarantineCommand}" Content="{loc:Loc protection.quarantine.load}" Margin="0" />
            <TextBlock Text="{loc:Loc protection.quarantine.title}" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Quarantine}" Focusable="False">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="c:Motion.Appear" Value="True" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <c:Card Padding="18,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Text}" Content="{loc:Loc protection.restore.button}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <StackPanel>
                                <TextBlock Text="{Binding ThreatName}" Style="{StaticResource Text.TitleMedium}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBox Style="{StaticResource LtrText}" Text="{Binding Mode=OneWay}" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </c:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
