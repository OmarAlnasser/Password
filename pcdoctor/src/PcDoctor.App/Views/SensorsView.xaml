<UserControl x:Class="PcDoctor.App.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PcDoctor.App.Localization"
             xmlns:c="clr-namespace:PcDoctor.App.Controls"
             xmlns:v="clr-namespace:PcDoctor.App.Views">
    <UserControl.Resources>
        <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <v:InverseBoolToVisibilityConverter x:Key="InverseBool" />
        <v:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
    </UserControl.Resources>
    <StackPanel>
        <v:PageHeader />

        <c:Card IsInteractive="False" Margin="0,0,0,14" Visibility="{Binding PawnIoInstalled, Converter={StaticResource InverseBool}}" c:Motion.Appear="True" c:Motion.Index="3">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding GetPawnIoCommand}" Content="{loc:Loc sensors.pawnio.open}"
                        VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel>
                    <TextBlock Text="{loc:Loc sensors.pawnio.title}" Style="{StaticResource Text.TitleMedium}" />
                    <TextBlock Text="{loc:Loc sensors.pawnio.body}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </c:Card>

        <WrapPanel Margin="0,0,0,14" c:Motion.Appear="True" c:Motion.Index="4">
            <Button Style="{StaticResource Btn.Primary}" Command="{Binding StartCommand}" Content="{loc:Loc sensors.start}"
                    Visibility="{Binding IsLive, Converter={StaticResource InverseBool}}" />
            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding StopCommand}" Content="{loc:Loc sensors.stop}"
                    Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}" />
            <Border Style="{StaticResource Kicker}" VerticalAlignment="Center" Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <c:LiveDot DotBrush="{DynamicResource Good}" IsLive="{Binding IsLive}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Soft}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter"><Setter Property="c:Motion.Appear" Value="True" /></Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}" Margin="2,8,0,8" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatTile}" Width="200" AutomationProperties.Name="{Binding Name}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Numeral}" FontSize="26"
                                                       Foreground="{Binding BrushKey, Converter={StaticResource KeyToBrush}}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <c:ShimmerBar Value="{Binding Fraction}" Margin="0,8,0,4" />
                                            <TextBlock Text="{Binding Max}" Style="{StaticResource Text.Caption}" FontSize="11.5" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{loc:Loc sensors.heuristic}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
