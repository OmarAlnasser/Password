<UserControl x:Class="PcDoctor.App.Views.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PcDoctor.App.Localization"
             xmlns:c="clr-namespace:PcDoctor.App.Controls"
             xmlns:v="clr-namespace:PcDoctor.App.Views"
             xmlns:vm="clr-namespace:PcDoctor.App.ViewModels">
    <UserControl.Resources>
        <v:SeverityBrushConverter x:Key="SeverityBrush" />
        <v:SeverityBackgroundConverter x:Key="SeverityBg" />
        <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <v:InverseBoolToVisibilityConverter x:Key="InverseBool" />
        <v:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>
    <StackPanel>
        <v:PageHeader />

        <!-- Empty state: no scan yet -->
        <c:Card IsInteractive="False" Visibility="{Binding HasReport, Converter={StaticResource InverseBool}}" Padding="28">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE9D9;" Style="{StaticResource Text.Icon}" FontSize="34" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Accent2}" />
                <TextBlock Text="{loc:Loc findings.empty.title}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,12,0,6" />
                <TextBlock Text="{loc:Loc findings.empty.body}" Style="{StaticResource Text.Body}" TextAlignment="Center" MaxWidth="520" />
            </StackPanel>
        </c:Card>

        <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
            <!-- Filters -->
            <ListBox ItemsSource="{Binding SeverityFilters}" SelectedItem="{Binding SeverityFilter}" Style="{StaticResource PlainList}"
                     ItemContainerStyle="{StaticResource PillItem}" DisplayMemberPath="Label" AutomationProperties.Name="{loc:Loc filter.severity}">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
            <DockPanel Margin="0,4,0,16">
                <ComboBox DockPanel.Dock="Right" Width="240" Margin="12,0,0,0" ItemsSource="{Binding ModuleFilters}"
                          SelectedItem="{Binding ModuleFilter}" DisplayMemberPath="Label" AutomationProperties.Name="{loc:Loc filter.area}" />
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="{loc:Loc filter.showHidden}" IsChecked="{Binding ShowHidden}"
                          Margin="16,0,0,0" />
                <Grid>
                    <TextBox Style="{StaticResource Input}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="42,10,14,10"
                             AutomationProperties.Name="{loc:Loc filter.search}" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="15" Margin="16,0,0,0" HorizontalAlignment="Left"
                               Foreground="{DynamicResource Muted}" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" MinWidth="300" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="6*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- List -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc findings.noMatch}" Style="{StaticResource Text.Caption}" Margin="4,8"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <ListBox ItemsSource="{Binding FindingsView}" SelectedItem="{Binding SelectedFinding}" Style="{StaticResource PlainList}"
                             ItemContainerStyle="{StaticResource CardItem}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="{loc:Loc dashboard.findings}">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
                        </ListBox.Template>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Overline}" Margin="4,14,4,8" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FindingItemViewModel}">
                                <DockPanel AutomationProperties.Name="{Binding Title}">
                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="11" Margin="0,0,14,0" VerticalAlignment="Top"
                                            Background="{Binding Severity, Converter={StaticResource SeverityBg}}">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.TitleMedium}" FontSize="15" />
                                        <TextBlock Text="{Binding Badges}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Detail -->
                <c:Card Grid.Column="2" IsInteractive="False" VerticalAlignment="Top" Padding="24,22"
                        DataContext="{Binding SelectedFinding}" Visibility="{Binding Converter={StaticResource NullToVisibility}}"
                        v:Reveal.OnDataContextChange="True">
                    <StackPanel>
                        <Border CornerRadius="999" Padding="12,4" HorizontalAlignment="Left"
                                Background="{Binding Severity, Converter={StaticResource SeverityBg}}">
                            <TextBlock Text="{Binding Badges}" FontSize="12.5" FontWeight="Medium"
                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                        </Border>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,12,0,0" />
                        <TextBlock Text="{loc:Loc finding.why}" Style="{StaticResource Text.Overline}" Margin="0,18,0,4" />
                        <TextBlock Text="{Binding Why}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{loc:Loc finding.suggested}" Style="{StaticResource Text.Overline}" Margin="0,16,0,4" />
                        <TextBlock Text="{Binding Action}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Ink}" />
                        <TextBlock Text="{loc:Loc finding.undo}" Style="{StaticResource Text.Overline}" Margin="0,16,0,4" />
                        <TextBlock Text="{Binding Undo}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{loc:Loc finding.evidence}" Style="{StaticResource Text.Overline}" Margin="0,18,0,6" />
                        <Border CornerRadius="12" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line2}" BorderThickness="1"
                                Padding="14,12">
                            <ItemsControl ItemsSource="{Binding Evidence}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10" FlowDirection="LeftToRight">
                                            <TextBox Style="{StaticResource LtrText}" Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                            <TextBox Style="{StaticResource LtrText}" Text="{Binding Value, Mode=OneWay}" Foreground="{DynamicResource Ink}"
                                                     MaxHeight="220" VerticalScrollBarVisibility="Auto" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <WrapPanel Margin="0,18,0,0">
                            <Button Style="{StaticResource Btn.Primary}" Content="{loc:Loc action.applyFix}"
                                    Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding DataContext.ApplyFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Style="{StaticResource Btn.Ghost}" Content="{loc:Loc action.copy}"
                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </WrapPanel>
                    </StackPanel>
                </c:Card>
            </Grid>

            <!-- What was checked -->
            <DockPanel Margin="0,26,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="{loc:Loc action.export}" Command="{Binding ExportCommand}"
                        Margin="0" />
                <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc dashboard.checks}" IsChecked="{Binding ShowChecks}"
                          FontWeight="SemiBold" />
            </DockPanel>
            <c:Card IsInteractive="False" Padding="8" Visibility="{Binding ShowChecks, Converter={StaticResource BoolToVisibility}}"
                    c:Motion.Appear="True">
                <DataGrid ItemsSource="{Binding ChecksView}" Style="{StaticResource ThemedGrid}" MaxHeight="440"
                          AutomationProperties.Name="{loc:Loc dashboard.checks}">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Overline}" Margin="10,12,4,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc checks.status}" Binding="{Binding StatusText}" Width="Auto" />
                        <DataGridTextColumn Header="{loc:Loc checks.item}" Binding="{Binding Title}" Width="2*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{loc:Loc checks.detail}" Binding="{Binding Detail}" Width="3*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </c:Card>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </StackPanel>
</UserControl>
