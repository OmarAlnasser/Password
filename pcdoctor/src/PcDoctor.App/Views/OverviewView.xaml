<UserControl x:Class="PcDoctor.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PcDoctor.App.Localization"
             xmlns:c="clr-namespace:PcDoctor.App.Controls"
             xmlns:v="clr-namespace:PcDoctor.App.Views">
    <UserControl.Resources>
        <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <v:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
    </UserControl.Resources>
    <StackPanel>
        <v:PageHeader />

        <!-- Scan card -->
        <c:Card IsFeatured="True" IsInteractive="False" Padding="26,24" c:Motion.Appear="True" c:Motion.Index="3">
            <StackPanel>
                <Border Style="{StaticResource Kicker}" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <c:LiveDot DotBrush="{DynamicResource Good}" IsLive="{Binding IsScanning}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding LastScan}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Soft}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{loc:Loc overview.scan.title}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{loc:Loc overview.scan.body}" Style="{StaticResource Text.Body}" Margin="0,6,0,18" MaxWidth="720"
                           HorizontalAlignment="Left" />
                <WrapPanel>
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding HealthCheckCommand}" ToolTip="{loc:Loc action.healthCheck.tip}"
                            AutomationProperties.Name="{loc:Loc action.healthCheck}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Text.Icon}" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Text="{loc:Loc action.healthCheck}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding DeepScanCommand}" ToolTip="{loc:Loc action.deepScan.tip}"
                            AutomationProperties.Name="{loc:Loc action.deepScan}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7EF;" Style="{StaticResource Text.Icon}" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Text="{loc:Loc action.deepScan}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Text}" Command="{Binding CancelCommand}" Content="{loc:Loc action.cancel}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" />
                </WrapPanel>
                <StackPanel Margin="0,18,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                    <c:ShimmerBar Value="{Binding Progress}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>
        </c:Card>

        <!-- Stat tiles -->
        <ItemsControl ItemsSource="{Binding Stats}" Margin="0,22,0,0" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}"
                      Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="c:Motion.Appear" Value="True" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource StatTile}" AutomationProperties.Name="{Binding Label}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Numeral}" c:CountUp.Value="{Binding Value}"
                                       Foreground="{Binding BrushKey, Converter={StaticResource KeyToBrush}}" />
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Summary -->
        <c:Card IsInteractive="False" Margin="0,10,0,0" c:Motion.Appear="True" c:Motion.Index="4">
            <StackPanel>
                <TextBlock Text="{loc:Loc dashboard.summary}" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Summary}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="2,9,12,0" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </c:Card>

        <!-- Areas -->
        <TextBlock Text="{loc:Loc overview.areas}" Style="{StaticResource SectionHeader}" Margin="0,26,0,10"
                   Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Modules}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="c:Motion.Appear" Value="True" />
                    <Setter Property="Margin" Value="0,0,12,12" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" Cursor="Hand" AutomationProperties.Name="{Binding Name}"
                            FocusVisualStyle="{StaticResource FocusVisual}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button"><ContentPresenter /></ControlTemplate>
                        </Button.Template>
                        <c:Card MinHeight="150">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Margin="0,6,10,0" VerticalAlignment="Top"
                                            Background="{Binding WorstKey, Converter={StaticResource KeyToBrush}}" />
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Text.Icon}" FontSize="12" DockPanel.Dock="Right"
                                               Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.TitleMedium}" />
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Counts}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Body}" Margin="0,10,0,0" MaxHeight="70"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </c:Card>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
