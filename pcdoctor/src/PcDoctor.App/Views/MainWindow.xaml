<Window x:Class="PcDoctor.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PcDoctor.App.Localization"
        xmlns:vm="clr-namespace:PcDoctor.App.ViewModels"
        xmlns:views="clr-namespace:PcDoctor.App.Views"
        Title="{loc:Loc app.title}"
        Width="1180" Height="780" MinWidth="760" MinHeight="520"
        FontFamily="{StaticResource Font.Ui}" FontSize="14"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocSource.Instance}}"
        AutomationProperties.Name="{loc:Loc app.title}">
    <Window.Resources>
        <views:SeverityBrushConverter x:Key="SeverityBrush" />
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
        <DataTemplate x:Key="ChoiceTemplate">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>
    </Window.Resources>

    <TabControl Margin="8" Background="{DynamicResource Brush.Surface}">
        <!-- Dashboard -->
        <TabItem Header="{loc:Loc tab.dashboard}" AutomationProperties.Name="{loc:Loc tab.dashboard}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding HealthCheckCommand}"
                            Content="{loc:Loc action.healthCheck}" ToolTip="{loc:Loc action.healthCheck.tip}"
                            AutomationProperties.Name="{loc:Loc action.healthCheck}" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeepScanCommand}"
                            Content="{loc:Loc action.deepScan}" ToolTip="{loc:Loc action.deepScan.tip}"
                            AutomationProperties.Name="{loc:Loc action.deepScan}" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding CancelScanCommand}"
                            Content="{loc:Loc action.cancel}" AutomationProperties.Name="{loc:Loc action.cancel}" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}"
                            Content="{loc:Loc action.export}" AutomationProperties.Name="{loc:Loc action.export}" />
                    <ProgressBar Width="140" Height="6" Margin="8,0" VerticalAlignment="Center" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}"
                               AutomationProperties.LiveSetting="Polite" />
                </WrapPanel>

                <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                        Padding="12,8" Margin="0,0,0,8" Background="{DynamicResource Brush.Surface}">
                    <ItemsControl ItemsSource="{Binding SummaryLines}" AutomationProperties.Name="{loc:Loc dashboard.summary}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock Text="{loc:Loc filter.severity}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="150" ItemsSource="{Binding SeverityFilters}" SelectedItem="{Binding SeverityFilter}"
                              ItemTemplate="{StaticResource ChoiceTemplate}" AutomationProperties.Name="{loc:Loc filter.severity}" />
                    <TextBlock Text="{loc:Loc filter.search}" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{loc:Loc filter.search}" />
                    <CheckBox Content="{loc:Loc filter.showHidden}" IsChecked="{Binding ShowHidden}" Margin="16,0,0,0"
                              VerticalAlignment="Center" />
                </WrapPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding FindingsView}" SelectedItem="{Binding SelectedFinding}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource Brush.Surface}"
                             BorderBrush="{DynamicResource Brush.Border}" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             AutomationProperties.Name="{loc:Loc dashboard.findings}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}" Margin="4,10,4,2" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FindingItemViewModel}">
                                <DockPanel Margin="2,4" AutomationProperties.Name="{Binding Title}">
                                    <Border DockPanel.Dock="Left" Width="4" Margin="0,0,8,0" CornerRadius="2"
                                            Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Badges}" FontSize="12"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                                  Focusable="True" AutomationProperties.Name="{loc:Loc dashboard.splitter}" />

                    <!-- Evidence drawer -->
                    <Border Grid.Column="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                            Background="{DynamicResource Brush.Surface}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                            <StackPanel DataContext="{Binding SelectedFinding}"
                                        Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Badges}" Margin="0,4,0,0"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                <TextBlock Text="{loc:Loc finding.why}" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="{Binding Why}" />
                                <TextBlock Text="{loc:Loc finding.suggested}" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="{Binding Action}" />
                                <TextBlock Text="{loc:Loc finding.undo}" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="{Binding Undo}" />
                                <TextBlock Text="{loc:Loc finding.evidence}" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding Evidence}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6" FlowDirection="LeftToRight">
                                                <TextBox Style="{StaticResource LtrText}" Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                                <TextBox Style="{StaticResource LtrText}" Text="{Binding Value, Mode=OneWay}" MaxHeight="240"
                                                         VerticalScrollBarVisibility="Auto" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc action.copy}"
                                            Command="{Binding DataContext.CopyFindingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{loc:Loc action.copy}" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="{loc:Loc action.applyFix}"
                                            Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.ApplyFixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{loc:Loc action.applyFix}" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Expander Grid.Row="4" Header="{loc:Loc dashboard.checks}" Margin="0,8,0,0" MaxHeight="260">
                    <DataGrid ItemsSource="{Binding ChecksView}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                              AutomationProperties.Name="{loc:Loc dashboard.checks}">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,6,4,2" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc checks.status}" Binding="{Binding StatusText}" Width="Auto" />
                            <DataGridTextColumn Header="{loc:Loc checks.item}" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="{loc:Loc checks.detail}" Binding="{Binding Detail}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </Grid>
        </TabItem>

        <!-- Change journal -->
        <TabItem Header="{loc:Loc tab.changes}" AutomationProperties.Name="{loc:Loc tab.changes}">
            <DockPanel Margin="12">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc action.refresh}" Command="{Binding LoadJournalCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc journal.undoAll}" Command="{Binding UndoEverythingCommand}" />
                    <TextBlock Text="{loc:Loc journal.restorePointNote}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}"
                               MaxWidth="600" />
                </WrapPanel>
                <DataGrid ItemsSource="{Binding Journal}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserAddRows="False" AutomationProperties.Name="{loc:Loc tab.changes}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc journal.when}" Binding="{Binding When}" Width="Auto" />
                        <DataGridTextColumn Header="{loc:Loc journal.source}" Binding="{Binding Source}" Width="Auto" />
                        <DataGridTextColumn Header="{loc:Loc journal.state}" Binding="{Binding StateText}" Width="Auto" />
                        <DataGridTemplateColumn Header="{loc:Loc journal.change}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource LtrText}" Text="{Binding Change, Mode=OneWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}">
                                        <Button Content="{loc:Loc journal.undo}" Margin="2" Padding="8,2"
                                                Command="{Binding DataContext.UndoEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{loc:Loc journal.undoBatch}" Margin="2" Padding="8,2"
                                                Command="{Binding DataContext.UndoBatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Settings -->
        <TabItem Header="{loc:Loc tab.settings}" AutomationProperties.Name="{loc:Loc tab.settings}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="{loc:Loc settings.language}" Style="{StaticResource SectionHeader}" />
                    <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                              ItemTemplate="{StaticResource ChoiceTemplate}" AutomationProperties.Name="{loc:Loc settings.language}" />
                    <TextBlock Text="{loc:Loc settings.digits}" Style="{StaticResource SectionHeader}" />
                    <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding DigitStyles}" SelectedItem="{Binding SelectedDigits}"
                              ItemTemplate="{StaticResource ChoiceTemplate}" AutomationProperties.Name="{loc:Loc settings.digits}" />
                    <TextBlock Text="{loc:Loc settings.theme}" Style="{StaticResource SectionHeader}" />
                    <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                              ItemTemplate="{StaticResource ChoiceTemplate}" AutomationProperties.Name="{loc:Loc settings.theme}" />
                    <TextBlock Text="{loc:Loc settings.export}" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="{loc:Loc settings.redact}" IsChecked="{Binding RedactExports}" />
                    <TextBlock Text="{loc:Loc settings.privacy}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{loc:Loc settings.privacy.text}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
