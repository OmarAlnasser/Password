<UserControl x:Class="PcDoctor.App.Views.RepairsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PcDoctor.App.Localization"
             xmlns:c="clr-namespace:PcDoctor.App.Controls"
             xmlns:v="clr-namespace:PcDoctor.App.Views">
    <UserControl.Resources>
        <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <v:SeverityBrushConverter x:Key="SeverityBrush" />
        <v:SeverityBackgroundConverter x:Key="SeverityBg" />
    </UserControl.Resources>
    <StackPanel>
        <v:PageHeader />

        <c:Card IsFeatured="True" IsInteractive="False" Padding="26,22" c:Motion.Appear="True" c:Motion.Index="3">
            <StackPanel>
                <TextBlock Text="{loc:Loc repairs.recommended.title}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{loc:Loc repairs.recommended.body}" Style="{StaticResource Text.Body}" Margin="0,6,0,16" MaxWidth="760" HorizontalAlignment="Left" />
                <WrapPanel>
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding RecommendedCommand}" Content="{loc:Loc repairs.recommended.button}" />
                    <Button Style="{StaticResource Btn.Text}" Command="{Binding CancelCommand}" Content="{loc:Loc action.cancel}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <c:ShimmerBar IsIndeterminate="True" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>
        </c:Card>

        <UniformGrid Columns="2" Margin="0,14,0,0">
            <c:Card Margin="0,0,12,12" c:Motion.Appear="True" c:Motion.Index="4">
                <StackPanel>
                    <TextBlock Text="{loc:Loc repairs.dism.title}" Style="{StaticResource Text.TitleMedium}" />
                    <TextBlock Text="{loc:Loc repairs.dism.body}" Style="{StaticResource Text.Body}" Margin="0,4,0,12" />
                    <WrapPanel>
                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding DismCheckCommand}" Content="{loc:Loc repairs.kind.DismCheckHealth}" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding DismScanCommand}" Content="{loc:Loc repairs.kind.DismScanHealth}" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding DismRestoreCommand}" Content="{loc:Loc repairs.kind.DismRestoreHealth}" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </c:Card>
            <c:Card Margin="0,0,12,12" c:Motion.Appear="True" c:Motion.Index="5">
                <StackPanel>
                    <TextBlock Text="{loc:Loc repairs.sfc.title}" Style="{StaticResource Text.TitleMedium}" />
                    <TextBlock Text="{loc:Loc repairs.sfc.body}" Style="{StaticResource Text.Body}" Margin="0,4,0,12" />
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding SfcCommand}" Content="{loc:Loc repairs.kind.Sfc}" HorizontalAlignment="Left" />
                </StackPanel>
            </c:Card>
            <c:Card Margin="0,0,12,12" c:Motion.Appear="True" c:Motion.Index="6">
                <StackPanel>
                    <TextBlock Text="{loc:Loc repairs.chkdsk.title}" Style="{StaticResource Text.TitleMedium}" />
                    <TextBlock Text="{loc:Loc repairs.chkdsk.body}" Style="{StaticResource Text.Body}" Margin="0,4,0,12" />
                    <WrapPanel>
                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding ChkdskScanCommand}" Content="{loc:Loc repairs.kind.ChkdskScan}" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Btn.Text}" Command="{Binding ChkdskScheduleCommand}" Content="{loc:Loc repairs.chkdskFix.button}" />
                    </WrapPanel>
                </StackPanel>
            </c:Card>
            <c:Card Margin="0,0,12,12" c:Motion.Appear="True" c:Motion.Index="7">
                <StackPanel>
                    <TextBlock Text="{loc:Loc repairs.reboot.title}" Style="{StaticResource Text.TitleMedium}" />
                    <TextBlock Text="{loc:Loc repairs.reboot.body}" Style="{StaticResource Text.Body}" Margin="0,4,0,12" />
                    <WrapPanel>
                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding MemoryDiagnosticCommand}" Content="{loc:Loc repairs.memory.button}" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding DefenderOfflineCommand}" Content="{loc:Loc repairs.offline.button}" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </c:Card>
        </UniformGrid>

        <!-- Expert: Driver Verifier -->
        <c:Card IsInteractive="False" Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVisibility}}" c:Motion.Appear="True">
            <StackPanel>
                <Border Style="{StaticResource Kicker}" Margin="0,0,0,10">
                    <TextBlock Text="{loc:Loc repairs.verifier.kicker}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Warn}" Margin="4,0,0,0" />
                </Border>
                <TextBlock Text="{loc:Loc repairs.verifier.title}" Style="{StaticResource Text.TitleMedium}" />
                <TextBlock Text="{loc:Loc repairs.verifier.body}" Style="{StaticResource Text.Body}" Margin="0,4,0,12" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Text}" Command="{Binding VerifierResetCommand}" Content="{loc:Loc repairs.verifier.reset}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding VerifierEnableCommand}" Content="{loc:Loc repairs.verifier.button}"
                            Margin="10,0" />
                    <TextBox Style="{StaticResource Input}" Text="{Binding VerifierDrivers, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                             FontFamily="{StaticResource Font.Mono}" AutomationProperties.Name="{loc:Loc repairs.verifier.title}" />
                </DockPanel>
            </StackPanel>
        </c:Card>

        <TextBlock Text="{loc:Loc repairs.log}" Style="{StaticResource SectionHeader}" />
        <ItemsControl ItemsSource="{Binding Log}" Focusable="False">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="c:Motion.Appear" Value="True" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <c:Card Padding="16,12">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Margin="0,6,14,0" VerticalAlignment="Top"
                                    Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Text.Caption}" FlowDirection="LeftToRight" />
                            <StackPanel>
                                <TextBlock Text="{Binding Step}" Style="{StaticResource Text.TitleMedium}" FontSize="15" />
                                <TextBlock Text="{Binding Outcome}" Style="{StaticResource Text.Body}" />
                            </StackPanel>
                        </DockPanel>
                    </c:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
