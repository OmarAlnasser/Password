<UserControl x:Class="PcDoctor.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PcDoctor.App.Localization"
             xmlns:c="clr-namespace:PcDoctor.App.Controls"
             xmlns:v="clr-namespace:PcDoctor.App.Views">
    <UserControl.Resources>
        <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <v:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
    </UserControl.Resources>
    <StackPanel>
        <v:PageHeader />
        <DockPanel Margin="0,0,0,14" c:Motion.Appear="True" c:Motion.Index="3">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding LoadCommand}" Content="{loc:Loc action.refresh}" Margin="12,0,0,0" />
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="{loc:Loc startup.hideMicrosoft}" IsChecked="{Binding HideMicrosoft}" Margin="16,0,0,0" />
            <Grid>
                <TextBox Style="{StaticResource Input}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="42,10,14,10"
                         AutomationProperties.Name="{loc:Loc filter.search}" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="15" Margin="16,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource Muted}" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>
        <c:ShimmerBar IsIndeterminate="True" Margin="0,0,0,10" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />

        <ItemsControl ItemsSource="{Binding View}" Focusable="False">
            <ItemsControl.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Text.Overline}" Margin="4,14,4,8" /></DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="c:Motion.Appear" Value="True" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <c:Card Padding="16,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Text}" Content="{loc:Loc startup.disable.button}" VerticalAlignment="Center"
                                    Visibility="{Binding CanDisable, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Top"
                                    Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line2}" BorderThickness="1">
                                <Ellipse Width="9" Height="9" Fill="{Binding SignatureKey, Converter={StaticResource KeyToBrush}}" />
                            </Border>
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.TitleMedium}" FontSize="15" Margin="0,0,10,0" />
                                    <Border Style="{StaticResource Tag}">
                                        <TextBlock Text="{Binding SignatureText}" FontSize="12" Foreground="{Binding SignatureKey, Converter={StaticResource KeyToBrush}}" />
                                    </Border>
                                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                </WrapPanel>
                                <TextBox Style="{StaticResource LtrText}" Text="{Binding Image, Mode=OneWay}" Margin="0,4,0,0" Foreground="{DynamicResource Muted}" />
                            </StackPanel>
                        </DockPanel>
                    </c:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
