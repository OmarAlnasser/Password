<UserControl x:Class="PcDoctor.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PcDoctor.App.Localization"
             xmlns:c="clr-namespace:PcDoctor.App.Controls"
             xmlns:v="clr-namespace:PcDoctor.App.Views">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
        <v:PageHeader />

        <c:Card IsInteractive="False" c:Motion.Appear="True" c:Motion.Index="3">
            <StackPanel>
                <TextBlock Text="{loc:Loc settings.appearance}" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,14" />
                <TextBlock Text="{loc:Loc settings.language}" Style="{StaticResource Text.Overline}" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Style="{StaticResource PlainList}"
                         ItemContainerStyle="{StaticResource PillItem}" DisplayMemberPath="Label" AutomationProperties.Name="{loc:Loc settings.language}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Text="{loc:Loc settings.theme}" Style="{StaticResource Text.Overline}" Margin="0,12,0,6" />
                <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Style="{StaticResource PlainList}"
                         ItemContainerStyle="{StaticResource PillItem}" DisplayMemberPath="Label" AutomationProperties.Name="{loc:Loc settings.theme}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Text="{loc:Loc settings.digits}" Style="{StaticResource Text.Overline}" Margin="0,12,0,6" />
                <ListBox ItemsSource="{Binding DigitStyles}" SelectedItem="{Binding SelectedDigits}" Style="{StaticResource PlainList}"
                         ItemContainerStyle="{StaticResource PillItem}" DisplayMemberPath="Label" AutomationProperties.Name="{loc:Loc settings.digits}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
                <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc settings.reduceMotion}" IsChecked="{Binding ReduceMotion}" Margin="0,12,0,0" />
            </StackPanel>
        </c:Card>

        <c:Card IsInteractive="False" Margin="0,14,0,0" c:Motion.Appear="True" c:Motion.Index="4">
            <StackPanel>
                <TextBlock Text="{loc:Loc settings.export}" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,8" />
                <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc settings.redact}" IsChecked="{Binding RedactExports}" />
            </StackPanel>
        </c:Card>

        <c:Card IsInteractive="False" Margin="0,14,0,0" c:Motion.Appear="True" c:Motion.Index="5">
            <StackPanel>
                <TextBlock Text="{loc:Loc settings.network}" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,8" />
                <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc settings.symbols}" IsChecked="{Binding AllowSymbolDownload}" />
                <TextBlock Text="{loc:Loc settings.symbols.note}" Style="{StaticResource Text.Caption}" Margin="56,0,0,0" />
            </StackPanel>
        </c:Card>

        <c:Card IsInteractive="False" Margin="0,14,0,0" c:Motion.Appear="True" c:Motion.Index="6">
            <StackPanel>
                <TextBlock Text="{loc:Loc settings.privacy}" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,8" />
                <TextBlock Text="{loc:Loc settings.privacy.text}" Style="{StaticResource Text.Body}" />
            </StackPanel>
        </c:Card>

        <c:Card IsInteractive="False" Margin="0,14,0,0" c:Motion.Appear="True" c:Motion.Index="7">
            <StackPanel>
                <TextBlock Text="{loc:Loc settings.about}" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,8" />
                <WrapPanel>
                    <TextBlock Text="{loc:Loc settings.version}" Style="{StaticResource Text.Body}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" FlowDirection="LeftToRight" />
                </WrapPanel>
                <TextBlock Text="{loc:Loc settings.licenses}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
            </StackPanel>
        </c:Card>
    </StackPanel>
</UserControl>
