<Window x:Class="PcDoctor.App.Views.ConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PcDoctor.App.Localization"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.Ui}" Foreground="{DynamicResource Ink}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocSource.Instance}}">
    <Grid Margin="40">
        <Border x:Name="Panel" CornerRadius="22" Background="{DynamicResource DialogGradient}" BorderBrush="{DynamicResource DialogBorder}"
                BorderThickness="1" Padding="28,26" MaxWidth="620" MinWidth="440">
            <Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="20" Direction="270" Opacity="0.6" Color="{DynamicResource ShadowColor}" /></Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" AutomationProperties.HeadingLevel="Level1" />
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,12,0,22" Focusable="False">
                    <TextBlock x:Name="BodyText" Style="{StaticResource Text.Body}" />
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource Btn.Ghost}" Content="{loc:Loc action.cancel}" IsCancel="True" Click="OnCancel" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource Btn.Primary}" IsDefault="True" Click="OnConfirm" Margin="0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
