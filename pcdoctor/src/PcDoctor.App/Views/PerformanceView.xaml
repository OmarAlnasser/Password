<UserControl x:Class="PcDoctor.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PcDoctor.App.Localization"
             xmlns:c="clr-namespace:PcDoctor.App.Controls"
             xmlns:v="clr-namespace:PcDoctor.App.Views">
    <UserControl.Resources>
        <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <v:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
        <DataTemplate x:Key="SessionTemplate">
            <TextBlock FlowDirection="LeftToRight">
                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="{Binding StartedUtc, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm} UTC}" />
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <v:PageHeader />

        <c:Card IsFeatured="True" IsInteractive="False" Padding="26,22" c:Motion.Appear="True" c:Motion.Index="3">
            <StackPanel>
                <TextBlock Text="{loc:Loc bench.measure.title}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{loc:Loc bench.measure.body}" Style="{StaticResource Text.Body}" Margin="0,6,0,14" MaxWidth="760" HorizontalAlignment="Left" />
                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,0,0,10" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{DynamicResource Warn}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Warn}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,0,0,12">
                    <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc bench.set.cpu}" IsChecked="{Binding MeasureCpu}" Margin="0,0,18,0" />
                    <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc bench.set.background}" IsChecked="{Binding MeasureBackground}" Margin="0,0,18,0" />
                    <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc bench.set.disk}" IsChecked="{Binding MeasureDisk}" IsEnabled="{Binding DiskAvailable}" Margin="0,0,18,0" />
                    <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc bench.set.boot}" IsChecked="{Binding MeasureBoot}" Margin="0,0,18,0" />
                    <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc bench.set.network}" IsChecked="{Binding MeasureNetwork}" Margin="0,0,18,0" />
                </WrapPanel>
                <DockPanel Margin="0,0,0,14" Visibility="{Binding GameAvailable, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Left" Text="{loc:Loc bench.set.game}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox Style="{StaticResource Input}" Text="{Binding GameProcess, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MaxWidth="320"
                             HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc bench.set.game}" />
                </DockPanel>
                <WrapPanel>
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding RecordBeforeCommand}" Content="{loc:Loc bench.recordBefore}" />
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding RecordAfterCommand}" Content="{loc:Loc bench.recordAfter}" />
                    <Button Style="{StaticResource Btn.Text}" Command="{Binding CancelCommand}" Content="{loc:Loc action.cancel}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <c:ShimmerBar IsIndeterminate="True" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </c:Card>

        <TextBlock Text="{loc:Loc bench.compare}" Style="{StaticResource SectionHeader}" Margin="0,22,0,10" />
        <DockPanel Margin="0,0,0,12">
            <ComboBox Width="280" ItemsSource="{Binding Sessions}" SelectedItem="{Binding Before}" ItemTemplate="{StaticResource SessionTemplate}"
                      AutomationProperties.Name="{loc:Loc bench.before}" />
            <TextBlock Text="&#xE72A;" Style="{StaticResource Text.Icon}" Margin="14,0" Foreground="{DynamicResource Muted}" />
            <ComboBox Width="280" ItemsSource="{Binding Sessions}" SelectedItem="{Binding After}" ItemTemplate="{StaticResource SessionTemplate}"
                      HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc bench.after}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="c:Motion.Appear" Value="True" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <c:Card Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.6*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Metric}" Style="{StaticResource Text.TitleMedium}" FontSize="15" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Before}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Soft}"
                                       VerticalAlignment="Center" FlowDirection="LeftToRight" />
                            <TextBlock Grid.Column="2" Text="{Binding After}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Ink}"
                                       VerticalAlignment="Center" FlowDirection="LeftToRight" />
                            <TextBlock Grid.Column="3" Text="{Binding Change}" FontFamily="{StaticResource Font.Brand}" FontSize="16" FontWeight="SemiBold" Margin="12,0"
                                       VerticalAlignment="Center" FlowDirection="LeftToRight" Foreground="{Binding VerdictKey, Converter={StaticResource KeyToBrush}}" />
                            <Border Grid.Column="4" CornerRadius="999" Padding="12,4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    BorderThickness="1" BorderBrush="{Binding VerdictKey, Converter={StaticResource KeyToBrush}}">
                                <TextBlock Text="{Binding Verdict}" FontSize="12.5" FontWeight="Medium" Foreground="{Binding VerdictKey, Converter={StaticResource KeyToBrush}}" />
                            </Border>
                        </Grid>
                    </c:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Margin="0,22,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding TraceLatencyCommand}" Content="{loc:Loc bench.latency.run}" Margin="0" />
            <TextBlock Text="{loc:Loc bench.latency.title}" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="{Binding LatencyNote}" Style="{StaticResource Text.Body}" Margin="0,0,0,8" />
        <c:Card IsInteractive="False" Padding="8">
            <DataGrid ItemsSource="{Binding Latency}" Style="{StaticResource ThemedGrid}" MaxHeight="360">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc bench.latency.driver}" Binding="{Binding Driver}" Width="2*" />
                    <DataGridTextColumn Header="{loc:Loc bench.latency.dpc}" Binding="{Binding Dpc}" Width="*" />
                    <DataGridTextColumn Header="{loc:Loc bench.latency.isr}" Binding="{Binding Isr}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </c:Card>
    </StackPanel>
</UserControl>
