<UserControl x:Class="PcDoctor.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PcDoctor.App.Localization"
             xmlns:c="clr-namespace:PcDoctor.App.Controls"
             xmlns:v="clr-namespace:PcDoctor.App.Views">
    <UserControl.Resources>
        <v:SeverityBrushConverter x:Key="SeverityBrush" />
        <DataTemplate x:Key="FindingRow">
            <c:Card Padding="14,10" Margin="0,0,0,8">
                <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,6,12,0" VerticalAlignment="Top" Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.TitleMedium}" FontSize="14.5" />
                        <TextBlock Text="{Binding Badges}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </DockPanel>
            </c:Card>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <v:PageHeader />
        <c:Card IsInteractive="False" c:Motion.Appear="True" c:Motion.Index="3">
            <StackPanel>
                <TextBlock Text="{loc:Loc history.schedule.title}" Style="{StaticResource Text.TitleMedium}" />
                <TextBlock Text="{loc:Loc history.schedule.body}" Style="{StaticResource Text.Body}" Margin="0,4,0,10" />
                <ListBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PillItem}"
                         DisplayMemberPath="Label" AutomationProperties.Name="{loc:Loc history.schedule.title}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </c:Card>

        <TextBlock Text="{loc:Loc history.compare}" Style="{StaticResource SectionHeader}" Margin="0,22,0,10" />
        <DockPanel Margin="0,0,0,10">
            <ComboBox Width="320" ItemsSource="{Binding Entries}" SelectedItem="{Binding Older}" DisplayMemberPath="Label" AutomationProperties.Name="{loc:Loc history.older}" />
            <TextBlock Text="&#xE72A;" Style="{StaticResource Text.Icon}" Margin="14,0" Foreground="{DynamicResource Muted}" />
            <ComboBox Width="320" ItemsSource="{Binding Entries}" SelectedItem="{Binding Newer}" DisplayMemberPath="Label" HorizontalAlignment="Left"
                      AutomationProperties.Name="{loc:Loc history.newer}" />
        </DockPanel>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" />
        <UniformGrid Columns="3">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{loc:Loc history.new}" Style="{StaticResource Text.Overline}" Margin="2,0,0,8" />
                <ItemsControl ItemsSource="{Binding New}" ItemTemplate="{StaticResource FindingRow}" Focusable="False" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{loc:Loc history.resolved}" Style="{StaticResource Text.Overline}" Margin="2,0,0,8" />
                <ItemsControl ItemsSource="{Binding Resolved}" ItemTemplate="{StaticResource FindingRow}" Focusable="False" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Loc history.persisting}" Style="{StaticResource Text.Overline}" Margin="2,0,0,8" />
                <ItemsControl ItemsSource="{Binding Persisting}" ItemTemplate="{StaticResource FindingRow}" Focusable="False" />
            </StackPanel>
        </UniformGrid>
    </StackPanel>
</UserControl>
