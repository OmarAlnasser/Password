<UserControl x:Class="PcDoctor.App.Views.ChangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PcDoctor.App.Localization"
             xmlns:c="clr-namespace:PcDoctor.App.Controls"
             xmlns:v="clr-namespace:PcDoctor.App.Views">
    <UserControl.Resources>
        <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <StackPanel>
        <v:PageHeader />
        <WrapPanel Margin="0,0,0,16" c:Motion.Appear="True" c:Motion.Index="3">
            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding LoadCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="15" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc action.refresh}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding UndoEverythingCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7A7;" Style="{StaticResource Text.Icon}" FontSize="15" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc journal.undoAll}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </WrapPanel>
        <Border Style="{StaticResource Kicker}" Margin="0,0,0,18" c:Motion.Appear="True" c:Motion.Index="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{DynamicResource Accent2}" Margin="4,0,8,0" />
                <TextBlock Text="{loc:Loc journal.restorePointNote}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Soft}"
                           MaxWidth="820" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <c:Card IsInteractive="False" Padding="28" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE81C;" Style="{StaticResource Text.Icon}" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource Accent2}" />
                <TextBlock Text="{loc:Loc journal.empty}" Style="{StaticResource Text.Body}" TextAlignment="Center" Margin="0,12,0,0" MaxWidth="480" />
            </StackPanel>
        </c:Card>

        <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="c:Motion.Appear" Value="True" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <c:Card Padding="18,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}">
                                <Button Style="{StaticResource Btn.Text}" Content="{loc:Loc journal.undo}"
                                        Command="{Binding DataContext.UndoEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource Btn.Text}" Content="{loc:Loc journal.undoBatch}"
                                        Command="{Binding DataContext.UndoBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                            <StackPanel>
                                <WrapPanel>
                                    <Border Style="{StaticResource Tag}">
                                        <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{DynamicResource Accent2}" />
                                    </Border>
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Text.TitleMedium}" FontSize="15" FlowDirection="LeftToRight" />
                                    <TextBlock Text="{Binding When}" Style="{StaticResource Text.Caption}" Margin="12,2,0,0" FlowDirection="LeftToRight" />
                                </WrapPanel>
                                <TextBox Style="{StaticResource LtrText}" Text="{Binding Change, Mode=OneWay}" Margin="0,8,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </c:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
