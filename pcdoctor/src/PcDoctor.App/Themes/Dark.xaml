<!-- Khazna dark tokens (docs/DESIGN.md section 2.1, 2.3, 2.5). Dark is the default identity. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#07060F" />
    <SolidColorBrush x:Key="Bg2" Color="#0C0A17" />
    <SolidColorBrush x:Key="Surface" Color="#120E1F" />
    <SolidColorBrush x:Key="Surface2" Color="#191329" />
    <SolidColorBrush x:Key="Surface3" Color="#221A38" />
    <SolidColorBrush x:Key="Ink" Color="#F4F1FA" />
    <SolidColorBrush x:Key="Soft" Color="#D6CBE8" />
    <SolidColorBrush x:Key="Muted" Color="#AAA6BC" />
    <SolidColorBrush x:Key="Line" Color="#262036" />
    <SolidColorBrush x:Key="Line2" Color="#3A2D50" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#74629A" />
    <SolidColorBrush x:Key="Accent" Color="#A17CF5" />
    <SolidColorBrush x:Key="Accent2" Color="#C9A8FF" />
    <SolidColorBrush x:Key="Strong" Color="#8251D4" />
    <SolidColorBrush x:Key="StrongHover" Color="#8A59DD" />
    <SolidColorBrush x:Key="StrongPressed" Color="#7545CB" />
    <SolidColorBrush x:Key="OnStrong" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Good" Color="#7FE0A8" />
    <SolidColorBrush x:Key="GoodContainer" Color="#10281C" />
    <SolidColorBrush x:Key="Warn" Color="#F2C46D" />
    <SolidColorBrush x:Key="WarnContainer" Color="#33270D" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F26D6D" />
    <SolidColorBrush x:Key="ErrorContainer" Color="#3A1620" />
    <SolidColorBrush x:Key="PrimaryContainer" Color="#251D3C" />
    <SolidColorBrush x:Key="SelectedFill" Color="#22A17CF5" />
    <SolidColorBrush x:Key="SelectedBorder" Color="#7A5BA6" />
    <SolidColorBrush x:Key="HoverFill" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="GhostFill" Color="#06FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#2E2340" />
    <SolidColorBrush x:Key="CardHoverBorder" Color="#7A5BA6" />
    <SolidColorBrush x:Key="TopHighlight" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="Scrim" Color="#C402010B" />

    <!-- 140deg card, 130deg featured, radial dialog. -->
    <LinearGradientBrush x:Key="CardGradient" StartPoint="0.18,0" EndPoint="0.82,1">
        <GradientStop Color="#151023" Offset="0" />
        <GradientStop Color="#09080F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FeaturedGradient" StartPoint="0.1,0" EndPoint="0.9,1">
        <GradientStop Color="#221437" Offset="0" />
        <GradientStop Color="#0B0814" Offset="0.7" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FeaturedBorder" Color="#4A3368" />
    <RadialGradientBrush x:Key="DialogGradient" Center="1,0" GradientOrigin="1,0" RadiusX="1.3" RadiusY="1.3">
        <GradientStop Color="#35204D" Offset="0" />
        <GradientStop Color="#100A1C" Offset="0.65" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="DialogBorder" Color="#684686" />
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8251D4" Offset="0" />
        <GradientStop Color="#C9A8FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrandGlyph" Color="#0B0814" />
    <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7645D0" Offset="0" />
        <GradientStop Color="#DDA9FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroTextGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#C9A8FF" Offset="0" />
        <GradientStop Color="#8251D4" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="AmbientGlow" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#2E6A3FD0" Offset="0" />
        <GradientStop Color="#006A3FD0" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="CardHoverGlow" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.7" RadiusY="0.9">
        <GradientStop Color="#22B281F3" Offset="0" />
        <GradientStop Color="#00B281F3" Offset="1" />
    </RadialGradientBrush>

    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="ButtonGlowColor">#7D43CE</Color>
    <Color x:Key="DotGoodColor">#7FE0A8</Color>

    <SolidColorBrush x:Key="Severity.Critical" Color="#F26D6D" />
    <SolidColorBrush x:Key="Severity.High" Color="#F59A6B" />
    <SolidColorBrush x:Key="Severity.Medium" Color="#F2C46D" />
    <SolidColorBrush x:Key="Severity.Low" Color="#A17CF5" />
    <SolidColorBrush x:Key="Severity.Info" Color="#AAA6BC" />
    <SolidColorBrush x:Key="SeverityBg.Critical" Color="#3A1620" />
    <SolidColorBrush x:Key="SeverityBg.High" Color="#36201A" />
    <SolidColorBrush x:Key="SeverityBg.Medium" Color="#33270D" />
    <SolidColorBrush x:Key="SeverityBg.Low" Color="#251D3C" />
    <SolidColorBrush x:Key="SeverityBg.Info" Color="#191329" />
</ResourceDictionary>
