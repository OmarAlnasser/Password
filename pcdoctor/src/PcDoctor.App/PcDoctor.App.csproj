<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PcDoctor.App</AssemblyName>
    <RootNamespace>PcDoctor.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same OFL fonts as Khazna (assets/fonts), bundled so nothing is fetched at run time. -->
    <Resource Include="Fonts\*.ttf" />
    <Content Include="Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PcDoctor.Core\PcDoctor.Core.csproj" />
    <ProjectReference Include="..\PcDoctor.Tweaks\PcDoctor.Tweaks.csproj" />
    <ProjectReference Include="..\PcDoctor.Platform.Appx\PcDoctor.Platform.Appx.csproj" />
    <ProjectReference Include="..\PcDoctor.Modules.Battery\PcDoctor.Modules.Battery.csproj" />
    <ProjectReference Include="..\PcDoctor.Modules.Crash\PcDoctor.Modules.Crash.csproj" />
    <ProjectReference Include="..\PcDoctor.Modules.Disk\PcDoctor.Modules.Disk.csproj" />
    <ProjectReference Include="..\PcDoctor.Modules.Drivers\PcDoctor.Modules.Drivers.csproj" />
    <ProjectReference Include="..\PcDoctor.Modules.Security\PcDoctor.Modules.Security.csproj" />
    <ProjectReference Include="..\PcDoctor.Modules.Malware\PcDoctor.Modules.Malware.csproj" />
    <ProjectReference Include="..\PcDoctor.Modules.Persistence\PcDoctor.Modules.Persistence.csproj" />
    <ProjectReference Include="..\PcDoctor.Modules.Network\PcDoctor.Modules.Network.csproj" />
    <ProjectReference Include="..\PcDoctor.Modules.Inventory\PcDoctor.Modules.Inventory.csproj" />
    <ProjectReference Include="..\PcDoctor.Modules.Integrity\PcDoctor.Modules.Integrity.csproj" />
    <ProjectReference Include="..\PcDoctor.Bench\PcDoctor.Bench.csproj" />
    <ProjectReference Include="..\PcDoctor.Modules.Sensors\PcDoctor.Modules.Sensors.csproj" />
    <!-- The Broker ships next to the app; the app checks for it there and nowhere else. -->
    <ProjectReference Include="..\PcDoctor.Broker\PcDoctor.Broker.csproj" />
    <ProjectReference Include="..\PcDoctor.Modules.Activity\PcDoctor.Modules.Activity.csproj" />
  </ItemGroup>
</Project>
